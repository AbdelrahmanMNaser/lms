#==============================================================================
# ENVIRONMENT CONFIGURATION (TEMPLATE)
#==============================================================================
# Copy this file to '.env' and fill in your local values.
# This file (.env.example) IS committed to version control.
# Your actual '.env' file IS NOT committed (it's ignored).

#------------------------------------------------------------------------------
# ENVIRONMENT STATE
#------------------------------------------------------------------------------
# development, production, test
NODE_ENV=development

#------------------------------------------------------------------------------
# CLIENT (FRONTEND)
#------------------------------------------------------------------------------
# The port the Vite dev server should run on
VITE_CLIENT_PORT=5000

# The base URL of the frontend application
VITE_CLIENT_DEV_BASE_URL=http://localhost:5000

#------------------------------------------------------------------------------
# SERVER API (BACKEND)
#------------------------------------------------------------------------------
# The port your backend server is running on
VITE_SERVER_PORT=3000

# The full API URL used by the frontend to communicate with the backend
VITE_SERVER_DEV_API_URL=http://localhost:3000/api
