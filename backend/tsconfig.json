{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",

    "rootDir": ".",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],

    "paths": {
      "@/prisma/*": ["./prisma/*"],
      "@/*": ["./src/*"]
    },
  },
  "include": ["src/**/*", "prisma/**/*"],
  "exclude": ["node_modules"]
}
